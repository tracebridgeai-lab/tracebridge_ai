# Firebase Admin SDK (Server-side)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_STORAGE_BUCKET=""

# Google Gemini
GEMINI_API_KEY="your-gemini-api-key"
# Set to "true" to use mock responses instead of calling Gemini API (useful for testing without quota)
GEMINI_MOCK_MODE="false"

# Firebase Client SDK (Client-side - already configured)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Site-wide login gate (src/middleware.ts). Set these in Vercel too.
SITE_AUTH_USER=
SITE_AUTH_PASSWORD=

# Only needed for scripts/create-beta-accounts.ts
BETA_ACCOUNT_PASSWORD=
# Operator-only routes (/api/admin/eval-core, /api/admin/rules/seed, /api/rules/seed)
# Comma-separated emails allowed to call them. Leave empty to disable those routes.
ADMIN_EMAILS=""

# Only for scripts/create-beta-accounts.ts. 12+ chars. Never commit a real value.
BETA_ACCOUNT_PASSWORD=""

# Optional site-wide Basic Auth gate (pages only, not /api). Set both in Vercel to enable.
SITE_BASIC_AUTH_USER=""
SITE_BASIC_AUTH_PASS=""
